datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum InquiryStatus {
  PENDING
  RESOLVED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient?
}

model Patient {
  id             String        @id @default(uuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  age            Int
  gender         String
  phone          String
  address        String
  medicalHistory String?
  appointments   Appointment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  imageUrl    String?
  icon        String?
  doctors     Doctor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Doctor {
  id           String        @id @default(uuid())
  fullName     String
  qualification String
  experience   Int           // Years of experience
  departmentId String
  department   Department    @relation(fields: [departmentId], references: [id])
  availability String        // Days/Hours of availability e.g. "Mon-Fri (09:00 AM - 05:00 PM)"
  bio          String
  imageUrl     String?
  email        String?
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id            String            @id @default(uuid())
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id])
  preferredDate String            // YYYY-MM-DD
  preferredTime String            // HH:MM
  symptoms      String
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ContactInquiry {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String
  subject   String?
  message   String
  status    InquiryStatus @default(PENDING)
  createdAt DateTime      @default(now())
}

model Blog {
  id        String   @id @default(uuid())
  title     String
  summary   String
  content   String   @db.Text
  category  String
  author    String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(uuid())
  patientName  String
  patientImage String?
  review       String
  rating       Int      @default(5)
  createdAt    DateTime @default(now())
}
